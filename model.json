{
  "kind": "image_viewer",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Image Viewer",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "image",
        "title": "Image",
        "accepts": [
          "image/path",
          "file/path",
          "message/*",
          "text/plain"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": []
  },
  "config": {},
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "display_node": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/image_viewer.css"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/image_viewer.css"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/image_viewer.css"
      }
    ]
  }
}
